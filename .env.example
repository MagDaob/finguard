# Copy to .env only when configuring an existing PostgreSQL instance.
# scripts/local-postgres.ps1 creates .env for a new local instance.
FINGUARD_DATABASE_URL=postgresql://finguard:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/finguard
FINGUARD_DATABASE_SCHEMA=finguard
FINGUARD_WORKER_ENABLED=true
FINGUARD_WORKER_INTERVAL_SECONDS=1
FINGUARD_EVALUATION_ENABLED=false
FINGUARD_CORS_ORIGINS=["http://localhost:5173"]
# Optional: set a random secret before accepting signed callbacks.
# FINGUARD_CALLBACK_SECRET=REPLACE_WITH_RANDOM_SECRET
# Optional: provider-neutral POST JSON planning gateway, described in docs/backend.md.
# FINGUARD_MODEL_URL=https://your-gateway.example/plan
# FINGUARD_MODEL_API_KEY=REPLACE_WITH_GATEWAY_KEY
# FINGUARD_MODEL_ALLOW_LOCAL_HTTP=false
# Docker Compose requires a separate URL-safe hexadecimal database password.
# FINGUARD_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEXADECIMAL_PASSWORD
